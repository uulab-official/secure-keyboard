{
  "name": "@secure-keypad/react-native",
  "version": "0.1.0",
  "type": "module",
  "description": "Secure Native React Native adapter with secret-free props and masked state events",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "files": ["dist", "android", "ios", "SecureKeypadReactNative.podspec", "app.plugin.js", "secure_ffi.xcframework", "libsecure_ffi.a", "LICENSE"],
  "main": "./dist/index.js",
  "app.plugin": "./app.plugin.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@secure-keypad/contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
