{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-keypad.dev/schema/layout.v1.json",
  "title": "Secure Keypad Layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$" },
    "direction": { "enum": ["ltr", "rtl"] },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "$ref": "#/$defs/key" }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": { "type": "boolean" },
        "display": { "type": "boolean" },
        "footer": { "type": "boolean" },
        "error": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 16 },
        "icon": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["input", "backspace", "submit", "clear", "cancel", "spacer"] },
        "accessibilityLabel": { "type": "string", "maxLength": 80 },
        "testId": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
